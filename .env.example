# Copy to .env (gitignored) and fill in only what you use. The shell wins over this file.
# Never commit .env, never paste a key into chat.

# ---- Voice-over (vf.py voice) — docs/voiceover.md
# ELEVENLABS_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# GOOGLE_TTS_API_KEY=
# OPENAI_API_KEY=

# ---- Vision model (vf.py watch) — docs/vision.md
# Where the API sits. openai = any OpenAI-compatible server (LM Studio, Ollama, vLLM, llama.cpp,
# OpenAI, OpenRouter); gemini = Google Gemini (sees motion, hears the audio; always cloud).
# VF_VISION_PROVIDER=openai
# VF_VISION_BASE_URL=http://localhost:1234/v1        # LM Studio
# VF_VISION_BASE_URL=http://localhost:11434/v1       # Ollama
# VF_VISION_BASE_URL=http://192.168.1.20:8000/v1     # a GPU box on your network (still local)
# VF_VISION_MODEL=google/gemma-4-e4b
# VF_VISION_API_KEY=                                  # not needed for a local server
# GEMINI_API_KEY=
# An endpoint off this machine/network is refused unless this is set (the footage would leave):
# VF_VISION_ALLOW_CLOUD=1

# ---- Machine specifics
# VF_WHISPER_MODEL=/path/to/ggml-model.bin
# VF_FFMPEG_BIN=/path/to/ffmpeg/bin
